{
  "name": "solid-daisy",
  "version": "0.4.1",
  "type": "module",
  "description": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.1 <25.0.0",
    "pnpm": ">=11.0.8 <12.0.0"
  },
  "scripts": {
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "start": "vite",
    "dev": "vite",
    "build": "pnpm generate-routes && vite build",
    "type-check": "tsc",
    "serve": "vite preview",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "check": "pnpm dlx @biomejs/biome check --write ./src",
    "check:unsafe": "pnpm dlx @biomejs/biome check --write --unsafe ./src",
    "check:all": "pnpm check && pnpm test:cov"
  },
  "dependencies": {
    "@solid-primitives/media": "^2.3.5",
    "@tanstack/router-plugin": "^1.168.11",
