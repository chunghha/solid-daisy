    "@tanstack/solid-router": "^1.170.8",
    "@tanstack/solid-router-devtools": "^1.167.0",
    "@tanstack/zod-adapter": "^1.167.0",
    "luxon": "^3.7.2",
    "solid-forms": "^0.5.2",
    "solid-js": "^1.9.13",
    "solid-spinner": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@fontsource/fira-mono": "^5.2.7",
