    "@tanstack/router-cli": "^1.167.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "c8": "^11.0.0",
    "daisyui": "~5.5.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "~8.0.14",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.7"
